# INACTIVE TEMPLATE. Incoming UDP is NOT provider-approved. Do not enable the calls profile yet.
listening-port=3478
tls-listening-port=5349
listening-ip=192.0.2.10
relay-ip=192.0.2.10
external-ip=192.0.2.10
min-port=49160
max-port=49200
realm=turn.vyrn.example.com
server-name=turn.vyrn.example.com
fingerprint
use-auth-secret
# static-auth-secret must be written only to deployment/secrets/turnserver.conf.
cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem
no-cli
no-multicast-peers
no-loopback-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
user-quota=8
total-quota=64
stale-nonce=600
no-tlsv1
no-tlsv1_1
