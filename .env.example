# TEMPLATE ONLY. Generate strong local values; never commit the real .env.
# Root service hostname, without a scheme or trailing slash.
VYRN_DOMAIN=vyrn.example.com
POSTGRES_PASSWORD=
VYRN_ADMIN_TOTP_SECRET=
VYRN_ADMIN_ALLOWED_CIDRS=127.0.0.0/8
# One-shot bootstrap reads these when explicitly passed to the container.
VYRN_BOOTSTRAP_EMAIL=
VYRN_BOOTSTRAP_PASSWORD=
VYRN_BOOTSTRAP_INVITE=
# External backup remains blocked until configured. Restic encrypts before upload.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VYRN_KEYSTORE_PATH=
VYRN_KEY_ALIAS=
VYRN_STORE_PASSWORD=
VYRN_KEY_PASSWORD=
